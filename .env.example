# ==============================================================================
# LOOTLY PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GEMINI OCR API (SERVER SECRET - REQUIRED FOR OCR)
# ------------------------------------------------------------------------------
# Server-side secret used exclusively by Vercel Serverless Function (/api/ocr-trade).
# Never exposed in client code or client bundles.
# Set this in Vercel Dashboard -> Settings -> Environment Variables.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. TWELVE DATA API KEY (SERVER SECRET - FOR AI TRADING DESK MARKET DATA)
# ------------------------------------------------------------------------------
# Server-side API key for fetching real-time XAU/USD multi-timeframe candles.
# Never exposed in client code or client bundles.
TWELVE_DATA_API_KEY=

# ------------------------------------------------------------------------------
# 3. TRADINGVIEW WEBHOOK SECRET (SERVER SECRET - OPTIONAL FALLBACK)
# ------------------------------------------------------------------------------
# Server-side secret used optionally by /api/tradingview-webhook to authenticate
# incoming market data alerts from TradingView fallback.
# Never exposed in client code or client bundles.
TRADINGVIEW_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. FIREBASE CLIENT CONFIGURATION (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# By default, Lootly loads the embedded firebase-applet-config.json.
# Set these variables if you wish to override with a custom Firebase project in Vercel:
# (Client-safe public identifiers, prefixed with VITE_)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

