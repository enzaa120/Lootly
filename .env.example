# ==============================================================================
# LOOTLY PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GEMINI OCR API (SERVER SECRET - REQUIRED FOR SCREENSHOT AUTO-READ)
# ------------------------------------------------------------------------------
# Server-side secret used exclusively by /api/ocr-trade.
# Provided automatically in AI Studio environment or set in Vercel / Cloud Run.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# By default, Lootly loads the embedded firebase-applet-config.json.
# Set these variables only if deploying to an external custom Firebase project:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
