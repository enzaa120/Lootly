rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /marketData/{symbol} {
      allow read: if true;
      allow write: if true;

      match /timeframes/{timeframe} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasAll(['symbol', 'timeframe', 'open', 'high', 'low', 'close', 'timestamp', 'receivedAt'])
                     && request.resource.data.open is number
                     && request.resource.data.high is number
                     && request.resource.data.low is number
                     && request.resource.data.close is number
                     && request.resource.data.high >= request.resource.data.low;
      }

      match /candles/{timeframe}/items/{candleId} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasAll(['symbol', 'timeframe', 'open', 'high', 'low', 'close', 'timestamp', 'receivedAt'])
                     && request.resource.data.open is number
                     && request.resource.data.high is number
                     && request.resource.data.low is number
                     && request.resource.data.close is number;
      }

      match /providerStatus/{providerId} {
        allow read, write: if true;
      }

      match /providerUsage/{date} {
        allow read, write: if true;
      }
    }

    match /aiDeskAnalyses/{analysisId} {
      allow read, write: if true;
    }
  }
}
