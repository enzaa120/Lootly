{
  "$schema": "https://firebase.google.com/schemas/firestore-blueprint.json",
  "collections": {
    "users": {
      "description": "User profiles and root documents",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "accountMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "subcollections": {
        "trades": {
          "description": "User journaled trades",
          "fields": {
            "id": { "type": "string" },
            "accountMode": { "type": "string" },
            "marketType": { "type": "string" },
            "status": { "type": "string" },
            "date": { "type": "string" },
            "time": { "type": "string" },
            "asset": { "type": "string" },
            "direction": { "type": "string" },
            "lot": { "type": "number" },
            "pnlIdr": { "type": "number" },
            "pnlPercent": { "type": "number" },
            "setupType": { "type": "string" },
            "entryReason": { "type": "string" },
            "session": { "type": "string" },
            "marketCondition": { "type": "string" },
            "emotionBefore": { "type": "string" },
            "confidenceLevel": { "type": "string" },
            "disciplineStatus": { "type": "string" },
            "mistakes": { "type": "array" },
            "lessonLearned": { "type": "string" },
            "screenshotProof": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        },
        "settings": {
          "description": "User trading settings and account parameters",
          "fields": {
            "startingBalanceDemo": { "type": "number" },
            "startingBalanceReal": { "type": "number" },
            "targetBalanceDemo": { "type": "number" },
            "targetBalanceReal": { "type": "number" },
            "dailyProfitTargetDemoIdr": { "type": "number" },
            "dailyProfitTargetDemoPercent": { "type": "number" },
            "dailyProfitTargetRealIdr": { "type": "number" },
            "dailyProfitTargetRealPercent": { "type": "number" },
            "maxDailyLossPercent": { "type": "number" },
            "stopAfterLosses": { "type": "number" }
          }
        },
        "pushSubscriptions": {
          "description": "Web Push notification client device registrations",
          "fields": {
            "endpoint": { "type": "string" },
            "p256dh": { "type": "string" },
            "auth": { "type": "string" },
            "deviceLabel": { "type": "string" },
            "enabled": { "type": "boolean" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        },
        "mt5Connectors": {
          "description": "User MT5 connector instances and connection status",
          "fields": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "tokenPrefix": { "type": "string" },
            "tokenHash": { "type": "string" },
            "status": { "type": "string" },
            "broker": { "type": "string" },
            "server": { "type": "string" },
            "accountNumber": { "type": "string" },
            "accountMode": { "type": "string" },
            "balance": { "type": "number" },
            "equity": { "type": "number" },
            "openPositionsCount": { "type": "number" },
            "revoked": { "type": "boolean" },
            "lastSyncAt": { "type": "string" },
            "createdAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        },
        "mt5Accounts": {
          "description": "User MT5 trading account summaries and raw position/deal sync",
          "fields": {
            "accountKey": { "type": "string" },
            "login": { "type": "string" },
            "maskedLogin": { "type": "string" },
            "broker": { "type": "string" },
            "server": { "type": "string" },
            "accountMode": { "type": "string" },
            "currency": { "type": "string" },
            "leverage": { "type": "number" },
            "balance": { "type": "number" },
            "equity": { "type": "number" },
            "margin": { "type": "number" },
            "freeMargin": { "type": "number" },
            "openPositionsCount": { "type": "number" },
            "lastSyncAt": { "type": "string" },
            "updatedAt": { "type": "string" }
          }
        }
      }
    },
    "mt5ConnectorTokens": {
      "description": "Global SHA-256 token mappings for authenticating MT5 webhook calls",
      "fields": {
        "tokenHash": { "type": "string" },
        "userId": { "type": "string" },
        "connectorId": { "type": "string" },
        "name": { "type": "string" },
        "revoked": { "type": "boolean" },
        "lastUsedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "marketData": {
      "description": "Live multi-timeframe market context and snapshot data for AI Trading Desk",
      "fields": {
        "symbol": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "activeSession": { "type": "string" }
      },
      "subcollections": {
        "timeframes": {
          "description": "Latest candle snapshots for H1, M15, M5",
          "fields": {
            "symbol": { "type": "string" },
            "timeframe": { "type": "string" },
            "open": { "type": "number" },
            "high": { "type": "number" },
            "low": { "type": "number" },
            "close": { "type": "number" },
            "volume": { "type": "number" },
            "timestamp": { "type": "number" },
            "session": { "type": "string" },
            "receivedAt": { "type": "string" }
          }
        },
        "candles": {
          "description": "Rolling candle history by timeframe",
          "fields": {
            "timeframe": { "type": "string" }
          },
          "subcollections": {
            "items": {
              "description": "Individual historical candle records",
              "fields": {
                "symbol": { "type": "string" },
                "timeframe": { "type": "string" },
                "open": { "type": "number" },
                "high": { "type": "number" },
                "low": { "type": "number" },
                "close": { "type": "number" },
                "volume": { "type": "number" },
                "timestamp": { "type": "number" },
                "session": { "type": "string" },
                "receivedAt": { "type": "string" }
              }
            }
          }
        },
        "providerStatus": {
          "description": "Provider synchronization metadata and upstream fetch timestamps",
          "fields": {
            "source": { "type": "string" },
            "lastFetchM5": { "type": "number" },
            "lastFetchM15": { "type": "number" },
            "lastFetchH1": { "type": "number" },
            "lastSuccessfulSync": { "type": "number" },
            "lastError": { "type": "string" },
            "updatedAt": { "type": "number" }
          }
        },
        "providerUsage": {
          "description": "Daily upstream provider request accounting to enforce quota guard",
          "fields": {
            "requestsM5": { "type": "number" },
            "requestsM15": { "type": "number" },
            "requestsH1": { "type": "number" },
            "totalRequests": { "type": "number" },
            "updatedAt": { "type": "number" }
          }
        },
        "monitor": {
          "description": "Background market monitor concurrency lock and state persistence",
          "fields": {
            "setupAnalysisId": { "type": "string" },
            "previousState": { "type": "string" },
            "currentState": { "type": "string" },
            "direction": { "type": "string" },
            "lastEvaluationAt": { "type": "string" },
            "lastMarketTimestamp": { "type": "number" },
            "preAlertSent": { "type": "boolean" },
            "validAlertSent": { "type": "boolean" },
            "locked": { "type": "boolean" },
            "lockedAt": { "type": "number" },
            "expiresAt": { "type": "number" },
            "lockId": { "type": "string" }
          }
        }
      }
    },
    "aiDeskAnalyses": {
      "description": "Institutional evaluation records and setup analysis snapshots from Meja Trading AI",
      "fields": {
        "setupAnalysisId": { "type": "string" },
        "symbol": { "type": "string" },
        "direction": { "type": "string" },
        "timestamp": { "type": "number" },
        "session": { "type": "string" },
        "decision": { "type": "string" },
        "decisionLabelIndo": { "type": "string" },
        "confidenceLabel": { "type": "string" },
        "ruleVersion": { "type": "string" },
        "entryZone": { "type": "string" },
        "referenceEntry": { "type": "number" },
        "stopLoss": { "type": "number" },
        "tp1": { "type": "number" },
        "tp2": { "type": "number" },
        "rrToTp1": { "type": "number" },
        "rrToTp2": { "type": "number" },
        "invalidationLevel": { "type": "number" },
        "invalidationReason": { "type": "string" },
        "setupCreatedAt": { "type": "number" },
        "setupExpiresAt": { "type": "number" },
        "marketPriceAtSignal": { "type": "number" },
        "preAlertSent": { "type": "boolean" },
        "validAlertSent": { "type": "boolean" },
        "pushSentAt": { "type": "string" },
        "marketDataTimestamp": { "type": "number" },
        "invalidation": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
